# Private server-side PostgreSQL connection; configure in .env.local
DATABASE_URL=postgresql://database_city_app:YOUR_PASSWORD@localhost:5432/database_city
# Neon env pull supplies a direct connection for schema setup:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/neondb?sslmode=require
NEXT_PUBLIC_LOCAL_MODE=false

# Optional administrator connection, only for scripts/setup-postgres.cjs
# DATABASE_ADMIN_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
